{
  "schema_version": "0.3-experimental",
  "extension_id": "org.vllm-hust.muxpd",
  "extension_version": "0.2.0a1",
  "kind": "scheduler_policy",
  "host": {
    "provider": "vllm",
    "name": "vllm",
    "version_range": "==0.1.dev1",
    "api_range": null
  },
  "runtime": {
    "type": "python",
    "process_scope": "engine_core_and_workers",
    "isolation": "trusted_in_process"
  },
  "lifecycle_owner": "vllm",
  "protocols": [
    {"name": "vllm.batch-admission-policy", "version_range": "==1.1"},
    {"name": "vllm.scheduler-class", "version_range": null},
    {"name": "vllm.worker-class", "version_range": null}
  ],
  "implementation": [
    {
      "type": "python_module",
      "module": "vllm_muxpd.decoupled_scheduler",
      "object": "DecoupledMuxPDScheduler",
      "status": "active"
    },
    {
      "type": "python_module",
      "module": "vllm_muxpd.policy",
      "object": "MuxPDPolicy",
      "status": "active"
    },
    {
      "type": "python_module",
      "module": "vllm_muxpd.decoupled_worker",
      "object": "DecoupledMuxPDNPUWorker",
      "status": "active"
    }
  ],
  "requires_services": [],
  "requires_extensions": [],
  "resource_claims": [
    {"resource": "vllm.process-carrier.scheduler", "scope": "vllm-process-tree", "mode": "exclusive"},
    {"resource": "vllm.process-carrier.worker", "scope": "vllm-process-tree", "mode": "exclusive"},
    {"resource": "vllm.scheduler.batch-admission-policy", "scope": "vllm-process-tree", "mode": "exclusive"}
  ],
  "components": [
    {
      "component_id": "scheduler",
      "contracts": ["vllm.scheduler-class.v1"],
      "execution_planes": ["scheduler"],
      "isolation": "trusted_in_process",
      "implementation_ref": "vllm_muxpd.decoupled_scheduler:DecoupledMuxPDScheduler",
      "permissions": []
    },
    {
      "component_id": "admission",
      "contracts": ["vllm.batch-admission-policy.v1"],
      "execution_planes": ["scheduler"],
      "isolation": "trusted_in_process",
      "implementation_ref": "vllm_muxpd.policy:MuxPDPolicy",
      "permissions": []
    },
    {
      "component_id": "worker",
      "contracts": ["vllm.worker-class.v1"],
      "execution_planes": ["worker"],
      "isolation": "trusted_in_process",
      "implementation_ref": "vllm_muxpd.decoupled_worker:DecoupledMuxPDNPUWorker",
      "permissions": []
    }
  ],
  "activation": {
    "entry_points": [],
    "environment": {"VLLM_USE_V2_MODEL_RUNNER": "0", "OMP_NUM_THREADS": "1"},
    "additional_config": {}
  }
}
