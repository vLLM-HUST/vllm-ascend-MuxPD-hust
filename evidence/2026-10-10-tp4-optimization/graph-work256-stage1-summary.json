  "candidate_stage": "graph-work256-stage1",
  "methods": {
    "throughput": "sum(request.usage.completion_tokens) / sum(run.wall_s); warmup requests excluded",
    "p95": "nearest rank over every measured request: sorted(values)[ceil(0.95*N)-1]; never mean of per-run percentiles",
    "tpot": "request mean (last nonempty content event - first nonempty content event)/(completion_tokens-1), not token-level p95",
    "goodput": "number of requests meeting both configured SLOs / sum(run.wall_s)",
    "stage_handling": "Initial and bracket run stages are retained separately; aggregate includes every one of the six runs; neither baseline stage is selected for a favorable comparison."
  },
  "limitations": [
    "Descriptive sequential three-repeat results; no randomized ordering or statistical significance claim.",
    "The variant combines a cohort token-work budget of 262144, optional full-P compilation, D-only fast path with same-stream entry-fence skipping, scheduler trace disabled, and no configured profiler; this is not a single-knob ablation.",
    "Keep both native graph stages and all-six-run aggregation; never select a weaker baseline.",
    "TTFT is first nonempty SSE text, TPOT is per-request mean, and max content gap is not necessarily per-token latency."
  ],
